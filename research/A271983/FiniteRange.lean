  split_covered_branch (q:=10) r5 s5 (by decide +kernel) (cons ⟨by decide +kernel,d266200⟩ (cons ⟨by decide +kernel,d556600⟩ nil))
private theorem bounds {n m : ℕ} (distinct : n ≠ m) (same : n.totient = m.totient)
    (hn : Even n) (hm : Even m) (covers : ∀ y : ℕ, y.totient=n.totient → y=n ∨ y=m)
    {x : ℕ} (hit : x.totient=n.totient) : 10000000000000000000≤x ∧ 2296666523712000000≤x.totient ∧ ∃ g ∈ goals, g ∣ x := by
  have xpos : 0 < x := lt_of_lt_of_le (by decide : 0<24200)
    (TotientLocal.input_lower_bound distinct same hn hm covers hit)
  have E : exceptional x := ⟨n,m,hn,hm,fun y hy => covers y (hy.trans hit)⟩
  rcases Local19.input_divisors distinct same hn hm covers hit with h|h|h|h
  · exact d24200 x xpos E h
  · exact d36300 x xpos E h
  · exact d298116 x xpos E h
  · exact d1910412 x xpos E h

theorem lower_bound {n m : ℕ} (distinct : n ≠ m) (same : n.totient = m.totient)
    (hn : Even n) (hm : Even m) (covers : ∀ y : ℕ, y.totient=n.totient → y=n ∨ y=m) {x : ℕ} (hit : x.totient=n.totient) : 10000000000000000000 ≤ x :=
  (bounds distinct same hn hm covers hit).1

theorem target_lower {n m : ℕ} (distinct : n ≠ m) (same : n.totient = m.totient)
    (hn : Even n) (hm : Even m) (covers : ∀ y : ℕ, y.totient=n.totient → y=n ∨ y=m) : 2296666523712000000 ≤ n.totient :=
  (bounds distinct same hn hm covers (x:=n) rfl).2.1

/-- Every exceptional input is divisible by an entry of the displayed terminal list. -/
theorem terminal_divisor {n m : ℕ} (distinct : n ≠ m) (same : n.totient = m.totient)
    (hn : Even n) (hm : Even m) (covers : ∀ y : ℕ, y.totient=n.totient → y=n ∨ y=m)
    {x : ℕ} (hit : x.totient=n.totient) : ∃ g ∈ goals, g ∣ x :=
  (bounds distinct same hn hm covers hit).2.2

