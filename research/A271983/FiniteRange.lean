namespace TotientDensity

/-- If every member of a finite set of positive integers up to N is a multiple
of one of D given divisors, each at least B, at most |D| floor(N/B) can occur. -/
theorem count_covered {N B : ℕ} (D S : Finset ℕ) (bpos : 0<B)
    (rangeS : ∀ x∈S, 0<x ∧ x≤N)
    (divisor : ∀ x∈S, ∃ d∈D, d ∣ x)
    (floor : ∀ d∈D, B≤d) : S.card ≤ D.card*(N/B) := by
  let I := Finset.Icc 1 (N/B)
  let mult (d : ℕ) := I.image (d*·)
  have incl : S ⊆ D.biUnion mult := by
    intro x hx
    obtain ⟨d,hd,dvd⟩ := divisor x hx
    obtain ⟨xpos,xle⟩ := rangeS x hx
    obtain ⟨k,hk⟩ := dvd
    have kpos : 0<k := Nat.pos_of_dvd_of_pos (hk ▸ dvd_mul_left _ _) xpos
    have kle : k≤N/B := by
      apply (Nat.le_div_iff_mul_le bpos).mpr
      calc
        k*B ≤ k*d := Nat.mul_le_mul_left _ (floor d hd)
        _ = x := by simpa [mul_comm] using hk.symm
        _ ≤ N := xle
    apply Finset.mem_biUnion.mpr ⟨d,hd,?_⟩
    exact Finset.mem_image.mpr ⟨k,Finset.mem_Icc.mpr ⟨kpos,kle⟩,hk.symm⟩
  calc
    S.card ≤ (D.biUnion mult).card := Finset.card_le_card incl
    _ ≤ ∑ d ∈ D, (mult d).card := Finset.card_biUnion_le
    _ ≤ ∑ _d ∈ D, I.card := Finset.sum_le_sum (fun _ _ => Finset.card_image_le)
    _ = D.card*(N/B) := by simp [I]

end TotientDensity

namespace TotientDensity

/-- Integer upper bounds for reciprocals avoid any rounding of real-valued densities. -/
theorem count_weighted (C N : ℕ) (w : ℕ → ℕ) (D : List ℕ) (S : Finset ℕ)
    (rangeS : ∀ x∈S, 0<x ∧ x≤N)
    (covered : ∀ x∈S, ∃ d∈D, d∣x)
    (caps : ∀ d∈D, 0<d ∧ C≤d*w d) :
    C*S.card ≤ N*(D.map w).sum := by
  induction D generalizing S with
  | nil =>
    have empty : S=∅ := Finset.eq_empty_iff_forall_notMem.mpr (fun x hx => by
      obtain ⟨d,hd,_⟩ := covered x hx; simp at hd)
    simp [empty]
  | cons d ds ih =>
    let A := S.filter (fun x => d∣x)
    let B := S.filter (fun x => ¬d∣x)
    have ra : ∀ x∈A, 0<x ∧ x≤N := fun x h => rangeS x (Finset.mem_filter.mp h).1
    have rb : ∀ x∈B, 0<x ∧ x≤N := fun x h => rangeS x (Finset.mem_filter.mp h).1
    obtain ⟨dpos,cw⟩ := caps d (by simp)
    have one := count_covered (N:=N) {d} A dpos ra
      (fun x h => ⟨d,by simp,(Finset.mem_filter.mp h).2⟩) (by simp)
    have leA : A.card ≤ N/d := by simpa using one
    have cA : C*A.card ≤ N*w d := calc
      C*A.card ≤ C*(N/d) := Nat.mul_le_mul_left _ leA
      _ ≤ (d*w d)*(N/d) := Nat.mul_le_mul_right _ cw
      _ = ((N/d)*d)*w d := by ac_rfl
      _ ≤ N*w d := Nat.mul_le_mul_right _ (Nat.div_mul_le_self N d)
    have cB := ih B rb (fun x hx => by
      obtain ⟨h₁,h₂⟩ := Finset.mem_filter.mp hx
      obtain ⟨y,hy,dy⟩ := covered x h₁
      rcases List.mem_cons.mp hy with h|h
      · exact (h₂ (h ▸ dy)).elim
      · exact ⟨y,h,dy⟩) (fun j hj => caps j (List.mem_cons_of_mem _ hj))
    have sz : A.card+B.card=S.card := Finset.card_filter_add_card_filter_not ..
    simpa only [←sz,Nat.mul_add,List.map_cons,List.sum_cons] using Nat.add_le_add cA cB

end TotientDensity


namespace TenQuintillion

/-- This counts inputs, not distinct totient values. -/
def IsEvenPairMember (x : ℕ) : Prop :=
  ∃ y : ℕ, x ≠ y ∧ x.totient = y.totient ∧ Even x ∧ Even y ∧
    ∀ z, z.totient=x.totient → z=x ∨ z=y

noncomputable def exceptionalInputCount (N : ℕ) : ℕ := by
  classical
  exact ((Finset.Icc 1 N).filter IsEvenPairMember).card

/-- A uniform bound for all N, obtained by counting positive multiples of
the 391 terminal divisors. -/
theorem exceptional_count (N : ℕ) :
    1000000000000000000000000 * exceptionalInputCount N ≤ N*7312123 := by
  classical
  let C : ℕ := 1000000000000000000000000
  let w (g : ℕ) := (C+g-1)/g
  let S := (Finset.Icc 1 N).filter IsEvenPairMember
  have rangeS : ∀ x∈S, 0<x ∧ x≤N :=
    fun x hx => Finset.mem_Icc.mp (Finset.mem_filter.mp hx).1
  have cover : ∀ x∈S, ∃ d∈goals, d∣x := by
    intro x hx
    obtain ⟨y,ne,same,ex,ey,exactly⟩ := (Finset.mem_filter.mp hx).2
    exact terminal_divisor ne same ex ey exactly (x:=x) rfl
  have cap : goals.all (fun g => decide (0<g ∧ C≤g*w g)) = true := by decide +kernel
  have size : (goals.map w).sum = 7312123 := by decide +kernel
  have result := TotientDensity.count_weighted C N w goals S rangeS cover (by simpa using cap)
  rw [size] at result
  exact result

end TenQuintillion

namespace TenQuintillion
/-- Below either certified bound a two-element fiber is an odd integer and its double. -/
theorem doubling_below_bound {n m : ℕ} (distinct : n ≠ m) (same : n.totient = m.totient)
    (covers : ∀ y : ℕ, y.totient = n.totient → y=n ∨ y=m)
    (small : min n m < 10000000000000000000 ∨ n.totient < 2296666523712000000) :
    (Odd n ∧ m=2*n) ∨ (Odd m ∧ n=2*m) := by
  by_cases on : Odd n
  · rcases covers (2*n) (Nat.totient_two_mul_of_odd on) with e|e
    · obtain ⟨i,hi⟩ := on; omega
    · exact Or.inl ⟨on,e.symm⟩
  by_cases om : Odd m
  · rcases covers (2*m) ((Nat.totient_two_mul_of_odd om).trans same.symm) with e|e
    · exact Or.inr ⟨om,e.symm⟩
    · obtain ⟨i,hi⟩ := om; omega
  have en := Nat.not_odd_iff_even.mp on
  have em := Nat.not_odd_iff_even.mp om
  have a := lower_bound distinct same en em covers (x:=n) rfl
  have b := lower_bound distinct same en em covers (x:=m) same.symm
  have c := target_lower distinct same en em covers
  omega

end TenQuintillion
