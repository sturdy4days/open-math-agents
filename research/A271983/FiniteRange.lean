import LocalObstruction

/-!
# Numerical and prime-power cases of the two-preimage totient conjecture

The supporting LocalObstruction module is published in the same directory.
Every numerical substitution and terminal branch is verified by the Lean kernel.
-/


namespace TotientLocal

/-- If two distinct odd primes divide a power of two times a prime power,
they must both equal the odd prime, an impossibility. -/
private theorem exclude_prime_pair {q r p a b : ℕ} (hq : q.Prime) (hr : r.Prime)
    (hp : p.Prime) (nq : q ≠ 2) (nr : r ≠ 2) (diff : q ≠ r)
    (dq : q ∣ 2^a*p^b) (dr : r ∣ 2^a*p^b) : False := by
  have unique {s : ℕ} (hs : s.Prime) (ns : s ≠ 2) (d : s ∣ 2^a*p^b) : s = p := by
    rcases hs.dvd_mul.mp d with h | h
    · exact False.elim (ns ((Nat.prime_dvd_prime_iff_eq hs Nat.prime_two).mp (hs.dvd_of_dvd_pow h)))
    · exact (Nat.prime_dvd_prime_iff_eq hs hp).mp (hs.dvd_of_dvd_pow h)
  exact diff ((unique hq nq dq).trans (unique hr nr dr).symm)

/-- The doubling conjecture holds whenever the odd part of the common totient
is a prime power, including the power-of-two case. -/
theorem doubling_for_one_odd_prime {n m p a b : ℕ} (distinct : n ≠ m)
    (same : n.totient = m.totient)
    (covers : ∀ y : ℕ, y.totient = n.totient → y=n ∨ y=m)
    (hp : p.Prime) (form : n.totient = 2^a*p^b) :
    (Odd n ∧ m=2*n) ∨ (Odd m ∧ n=2*m) := by
  apply doubling_outside_three_progressions distinct same covers
  · intro div
    rw [form] at div
    exact exclude_prime_pair (by decide : Nat.Prime 5) (by decide : Nat.Prime 11) hp
      (by decide) (by decide) (by decide) ((by decide : 5 ∣ 8800).trans div)
      ((by decide : 11 ∣ 8800).trans div)
  · intro div
    rw [form] at div
    exact exclude_prime_pair (by decide : Nat.Prime 3) (by decide : Nat.Prime 7) hp
      (by decide) (by decide) (by decide) ((by decide : 3 ∣ 78624).trans div)
      ((by decide : 7 ∣ 78624).trans div)
  · intro div
    rw [form] at div
    exact exclude_prime_pair (by decide : Nat.Prime 3) (by decide : Nat.Prime 7) hp
      (by decide) (by decide) (by decide) ((by decide : 3 ∣ 517104).trans div)
      ((by decide : 7 ∣ 517104).trans div)

end TotientLocal




namespace TotientLocal

/-- A displayed product of primes supplies the prime divisors of a number. -/
theorem factors_of_list {a : ℕ} (P : List ℕ) (product : P.prod=a) (prime : ∀ p ∈ P, Nat.Prime p) :
    a.primeFactors = P.toFinset := by
  subst a
  induction P with
  | nil => simp
  | cons p ps ih =>
    have hp := prime p (by simp)
    have hs : ∀ q ∈ ps, Nat.Prime q := fun q h => prime q (List.mem_cons_of_mem p h)
    have pos := List.prod_pos (fun q h => (hs q h).pos)
    simp [Nat.primeFactors_mul hp.ne_zero pos.ne', hp.primeFactors,ih hs]

def formPhi (a : ℕ) (s : Finset ℕ) : ℕ :=
  (a / ∏ p ∈ s, p) * ∏ p ∈ s, (p-1)

abbrev guardCheck (a b : ℕ) (A B : Finset ℕ) (ps : List ℕ) : Prop :=
  (∀ p ∈ A, p ∣ b ∨ p ∈ ps) ∧ (∀ p ∈ B, p ∣ a ∨ p ∈ ps)

abbrev factorValid (r : Move) (A B C : List ℕ) : Prop :=
  A.prod=r.a ∧ B.prod=r.b ∧ (r.e=0 ∨ C.prod=r.e) ∧
  (∀ p∈A++B++C, Nat.Prime p) ∧ 0<r.a ∧ 0<r.b ∧ formPhi r.a A.toFinset=formPhi r.b B.toFinset ∧
    guardCheck r.a r.b A.toFinset B.toFinset r.guards ∧
   (if r.e=0 then Odd r.b ∧ 2∈r.guards else formPhi r.a A.toFinset=formPhi r.e C.toFinset ∧
    guardCheck r.a r.e A.toFinset C.toFinset r.guards ∧ r.a≠r.b ∧ r.b≠r.e ∧ r.a≠r.e)

theorem valid_of_factors (r : Move) (A B C : List ℕ) (h : factorValid r A B C) : r.valid := by
  obtain ⟨a,b,c,prime,apos,bpos,phi,gd,extra⟩ := h
  have fa := factors_of_list A a (fun p hp => prime p (by simp [hp]))
  have fb := factors_of_list B b (fun p hp => prime p (by simp [hp]))
  refine ⟨apos,bpos,?_,?_,?_⟩
  · simpa only [fastPhi,formPhi, fa,fb] using phi
  · simpa only [guarded,guardCheck,fa,fb] using gd
  · by_cases z : r.e=0
    · simpa only [if_pos z] using extra
    · have fc := factors_of_list C (c.resolve_left z) (fun p hp => prime p (by simp [hp]))
      simpa only [if_neg z,fastPhi,formPhi,guarded,guardCheck,fa,fc] using extra

theorem phi_lb_of_factors {n lb : ℕ} (A : List ℕ)
    (h : A.prod=n ∧ (∀ p∈A,Nat.Prime p) ∧ lb ≤ formPhi n A.toFinset) : lb ≤ fastPhi n := by
  obtain ⟨v,prime,le⟩ := h
  simpa only [fastPhi,formPhi,factors_of_list A v prime] using le

end TotientLocal


namespace TotientLocal

/-- A lower bound on the input and its totient, valid at any exceptional multiple of a. -/
def CoveredBounds (goals : List ℕ) (lb target a : ℕ) : Prop :=
  ∀ x, 0 < x → exceptional x → a ∣ x → lb ≤ x ∧ target ≤ x.totient ∧ ∃ g ∈ goals, g ∣ x

theorem finish_covered_branch {goals : List ℕ} {lb target a : ℕ} (mem : a ∈ goals) (lower : lb ≤ a) (phi : target ≤ fastPhi a) :
    CoveredBounds goals lb target a := by
  intro x pos _ divides
  refine ⟨lower.trans (Nat.le_of_dvd pos divides), ?_, a, mem, divides⟩
  have ph : target ≤ a.totient := by simpa only [Nat.totient_eq_div_primeFactors_mul, fastPhi] using phi
  exact ph.trans (Nat.le_of_dvd (Nat.totient_pos.mpr pos) (Nat.totient_dvd_of_dvd divides))

theorem split_covered_branch {goals : List ℕ} {lb target a q : ℕ} (r : Move) (ok : r.valid) (eqn : r.a*q=a)
    (children : ∀ p ∈ r.guards, p.Coprime q ∧ CoveredBounds goals lb target (a*p)) :
    CoveredBounds goals lb target a := by
  rintro x pos E ⟨c,hc⟩
  have cp : 0<c := Nat.pos_of_dvd_of_pos (hc ▸ dvd_mul_left _ _) pos
  have qp : 0<q := by
    by_contra! zero
    have : q=0 := by omega
    have az : a=0 := by simpa [this] using eqn.symm
    simp [hc,az] at pos
  have xe : x=r.a*(q*c) := by rw [←mul_assoc,eqn,hc]
  obtain ⟨p,mem,force⟩ := r.force ok (q*c) (Nat.mul_pos qp cp) (xe ▸ E)
  obtain ⟨cop,child⟩ := children p mem
  exact child x pos E (hc ▸ Nat.mul_dvd_mul_left a (cop.dvd_of_dvd_mul_left force))

end TotientLocal


